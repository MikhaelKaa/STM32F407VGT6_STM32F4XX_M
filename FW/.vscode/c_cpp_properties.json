                "/usr/include/newlib",
                "${workspaceFolder}/CMSIS",
                "${workspaceFolder}/app/board_led",
                "${workspaceFolder}/app/dwt_delay",
                "${workspaceFolder}/app/cli",
                "${workspaceFolder}/src",
                "${workspaceFolder}/dev",
                "${workspaceFolder}/app/mem",
                "${workspaceFolder}/app/uping",
                "${workspaceFolder}/dev/dev_rng",
                "${workspaceFolder}/app/rng_gen",
                "${workspaceFolder}/dev/dev_uart"
            ],
            "defines": [
                "STM32F407xx",
                "BAREMETAL"
            ],
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-arm"
        },
        {
            "name": "Win",
            "includePath": [
                "C:/arm_tool/gcc/arm-none-eabi/include",
                "${workspaceFolder}/**",
                "${workspaceFolder}/CMSIS",
                "${workspaceFolder}/app/board_led",
                "${workspaceFolder}/app/dwt_delay",
                "${workspaceFolder}/app/cli",
                "${workspaceFolder}/src",
                "${workspaceFolder}/dev",
                "${workspaceFolder}/app/mem",
                "${workspaceFolder}/app/uping",
                "${workspaceFolder}/dev/dev_rng",
                "${workspaceFolder}/app/rng_gen",
                "${workspaceFolder}/dev/dev_uart",
                "${workspaceFolder}/app/svcall_test"
            ],
            "defines": [
                "BAREMETAL",
                "STM32F407xx"
            ],
            "compilerPath": "C:/arm_tool/gcc/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c99",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "${default}"
        }
    ],
    "version": 4
