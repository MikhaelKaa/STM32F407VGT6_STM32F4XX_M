{
    "configurations": [
        {
            "name": "arm_c_cpp_properties",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "includePath": [
                "/usr/include/newlib",
                "${workspaceFolder}/CMSIS",
                "${workspaceFolder}/app/board_led",
                "${workspaceFolder}/app/dwt_delay",
                "${workspaceFolder}/app/cli",
                "${workspaceFolder}/src",
                "${workspaceFolder}/dev",
                "${workspaceFolder}/dev/dev_uart1",
                "${workspaceFolder}/dev/dev_uart2",
                "${workspaceFolder}/app/mem",
                "${workspaceFolder}/app/uping"
